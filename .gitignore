# Sekrety i konfiguracja lokalna (wzór: config.example.env)
config.env
config.env.bak
.env

# Środowisko i cache narzędzi
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Artefakty generowane lub robocze (odtwarzalne albo zbyt duże do wersjonowania)
index.html
logs/
backup/
assets/inline/
.DS_Store

# data/ zawiera listy firm i adresy e-mail (dane osobowe kontaktów służbowych) — nie wersjonujemy.
data/

# Raporty z kampanii: zawierają adresy e-mail i treść odpowiedzi osób trzecich
raporty/

# Zbiory ze skanu bez bazy (ai.py zeskrapuj): zawierają adresy e-mail i telefony z cudzych stron
data/skrap/
