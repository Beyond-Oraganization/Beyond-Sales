# Konfiguracja — skopiuj ten plik jako config.env i uzupełnij hasła.
#
#   cp config.example.env config.env
#   chmod 600 config.env
#
# NIGDY nie udostępniaj/nie wysyłaj nikomu pliku config.env — zawiera hasło
# do skrzynki pocztowej i do bazy danych. Program czyta go tylko lokalnie,
# nigdy nie wypisuje haseł w logach, w panelu ani w index.html.
# Wartości wpisuj BEZ cudzysłowów (cudzysłowy zostałyby częścią hasła).

# ---- Baza danych (MySQL) --------------------------------------------------
# Bazę i użytkownika zakładasz raz w kliencie MySQL (polecenia: README.md).
# Używaj 127.0.0.1, nie "localhost" (sterownik nie mapuje localhost na gniazdo).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=perno_maile
DB_USER=perno_app
DB_PASSWORD=
# Opcjonalnie: połączenie przez gniazdo unix zamiast TCP (ma pierwszeństwo).
# DB_SOCKET=/tmp/mysql.sock

# ---- Wysyłka (SMTP) ---------------------------------------------------------
# ZenBox (home.pl) — potwierdź dokładny host/port w panelu home.pl:
# Poczta -> Ustawienia klienta pocztowego. Wartości poniżej to typowy punkt
# startowy, NIE pewnik — zweryfikuj, zanim zaczniesz wysyłać naprawdę.
# Przy okazji sprawdź tam też dzienny/godzinowy limit wysyłki tej skrzynki,
# żeby dopasować --daily-cap w send_emails.py.
SMTP_HOST=smtp.zenbox.pl
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=roman@z3x.pl
SMTP_PASSWORD=

# Nazwa widoczna jako nadawca (nagłówek "Od") i jako podpis na końcu maila.
# Puste pole = w treści maila zostanie literalny placeholder "[Imię i nazwisko]".
SENDER_NAME=Roman Patlai

# ---- Skraper stron firm (scrape.py, zakładka „Skraper") ----------------------
# Skraper uprzejmie pobiera strony firm do analizy i szukania kontaktów:
# zawsze respektuje robots.txt, na jedną domenę idzie najwyżej jedno żądanie
# naraz (odstęp co najmniej 1 s), a odmowa serwera zatrzymuje skanowanie firmy.
# Wszystkie wartości są przycinane do bezpiecznych zakresów — poniżej domyślne.
# Komentarze piszemy w osobnych liniach (config.env nie obcina komentarzy po wartości).
#
# Kontakt widoczny dla właścicieli stron w nagłówkach User-Agent i From
# (adres e-mail albo URL). Puste = użyty zostanie SMTP_USER z ostrzeżeniem.
SKRAPER_CONTACT=roman@z3x.pl
# Ile różnych domen naraz (1-100).
SKRAPER_CONCURRENCY=30
# Odstęp między żądaniami do tej samej domeny w sekundach (min. 1).
SKRAPER_DELAY=2.5
# Profil budżetu na firmę: zbalansowany (do 500 stron, domyślny) albo kontekst (ok. 25 stron z kolejki priorytetowej:
# strona główna, kontakt, o nas, oferta; kilka razy mniej ruchu i danych). Uprzejmość wobec hostów od profilu nie zależy.
SKRAPER_PROFILE=zbalansowany
# Poniższe liczby ustawiają się z profilu. Odkomentuj tylko te, które chcesz ustawić inaczej: nadpisują profil z tego pliku.
# Maksymalna głębokość linków od strony głównej (1-20; zbalansowany 10, kontekst 4).
# SKRAPER_MAX_DEPTH=10
# Limity na jedną firmę (kumulatywnie także po wznowieniach; zbalansowany 500 stron i 50 MB, kontekst 25 i 15).
# SKRAPER_MAX_PAGES=500
# SKRAPER_MAX_MB=50
# Limit czasu na jedno zajęcie firmy, w minutach (zbalansowany 30, kontekst 10).
# SKRAPER_MAX_MINUTES=30
# Ile żądań naraz do jednego adresu IP (hosting współdzielony), 1-10.
SKRAPER_IP_CAP=2
# Pas bezpieczeństwa: najwyżej tyle żądań na sekundę łącznie.
SKRAPER_MAX_RPS=15
# Pełny HTML zapisujemy: klucz = tylko strony kluczowe (start, kontakt, o nas, prawne, oferta); all; nie.
SKRAPER_STORE_HTML=klucz
